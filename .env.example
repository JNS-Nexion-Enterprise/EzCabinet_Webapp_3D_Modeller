# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "false" opens the admin surface for local work. Ignored in production.
AUTH_ENABLED=true
# Read once by `pnpm seed:superadmin`.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# WhatsApp Cloud API — production only, never set in preview.
# See docs/ops/whatsapp-ezcabinet-setup.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The WhatsApp Business Account id. Only the hourly health check reads it, to
# confirm `order_placed` is approved.
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_SALES_NUMBER=

# Online payment. WHICH gateway is the `payment-gateway` Vercel flag
# (src/flags.ts); these are only its keys. Missing keys = bank transfer.
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# https://dashboard.stripe.com/workbench/webhooks — endpoint /api/webhooks/payment/stripe
STRIPE_WEBHOOK_SECRET=

# Everything below is set on Vercel (`vercel env pull .env.local`); listed so
# the repo says what a deployment needs. Names only — values never go here.

# Postgres. Locally: `pnpm db:up`, then
# postgresql://cabinet:cabinet@localhost:5432/cabinet
DATABASE_URL=

# Vercel Blob — design exports, render meshes, site images.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# Mux — tutorial videos. Write credentials, server only.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Vercel Flags, and the secret Vercel sends with each cron call.
FLAGS_SECRET=
CRON_SECRET=

# Logistics partners. A partner with no keys is simply not offered.
GOOGLE_GEOCODING_API_KEY=
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
EASYPARCEL_CLIENT_ID=
EASYPARCEL_CLIENT_SECRET=
GDEX_PRIMARY_API_KEY=
GDEX_SECONDARY_API_SECRET=
GDEX_USER_TOKEN=
FEDEX_API_URL=
FEDEX_API_KEY=
FEDEX_API_PASSWORD=
FEDEX_ACCOUNT_NUMBER=

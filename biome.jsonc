{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!public",
			// pnpm writes it; anything else formatting it is undone on install.
			"!pnpm-lock.yaml",
			// Biome 2.6.2's Markdown formatter re-pads these tables differently on
			// every pass, so they never settle. Drop these lines once it does.
			"!docs/superpowers/plans/2026-09-06-easyparcel-integration.md",
			"!docs/superpowers/plans/2026-09-20-rbac.md",
			"!docs/superpowers/plans/2026-09-28-customer-account-shell.md"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}

# Copy to secrets.auto.tfvars (gitignored) and fill in. Keep a copy in the
# password manager: this file and the state are the only places these live.

state_passphrase = ""

# One shared account for every company.
shared_secrets = {
  MUX_TOKEN_ID             = ""
  MUX_TOKEN_SECRET         = ""
  GOOGLE_GEOCODING_API_KEY = ""
}

# One block per file in ../tenants. DATABASE_URL is required; leave out any
# service the company does not use. The accepted names are local.secret_names
# in modules/client/main.tf.
secrets = {
  demo = {
    DATABASE_URL           = ""
    GOOGLE_CLIENT_ID       = ""
    GOOGLE_CLIENT_SECRET   = ""
    RESEND_API_KEY         = ""
    STRIPE_SECRET_KEY      = ""
    STRIPE_PUBLISHABLE_KEY = ""
    STRIPE_WEBHOOK_SECRET  = ""
  }
}

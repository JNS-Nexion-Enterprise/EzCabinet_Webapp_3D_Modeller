# Copy to backend.hcl (gitignored). Cloudflare R2 shown; any S3-compatible
# bucket works. Credentials come from AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY (an R2 API token scoped to this one bucket).

bucket = "planner-tofu-state"
key    = "fleet.tfstate"
region = "auto"

endpoints = {
  s3 = "https://<cloudflare-account-id>.r2.cloudflarestorage.com"
}

# R2 is not AWS: skip the AWS-only checks.
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
use_path_style              = true
